---
import { getEntry, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import LayerDiagram from '../components/LayerDiagram.astro';
import SourceBlock from '../components/SourceBlock.astro';
import { getCounts, getRegistry, siteRoutes, version } from '../lib/harness/registry.ts';
import { honesty, listCli } from '../lib/harness/cli.ts';
import { REPO_URL, product, compatibility } from '../lib/harness/paths.ts';
import { docLink, sourceRoutes } from '../lib/harness/links.ts';
import { inlineCode } from '../lib/harness/text.ts';

const p = product();
const support = compatibility();
const c = getCounts();
const r = getRegistry();
const cli = listCli();
const h = honesty();
const v = version();
const routes = siteRoutes();
// A hook page is built under its registered id, not the stem of its script, so hook doc
// paths resolve through the registry rather than through their filename.
const bySource = sourceRoutes(r.hooks);
const demonstration = r.docs.some((entry) => entry.id === 'stance-demo') ? await getEntry('docs', 'stance-demo') : undefined;
const DemoContent = demonstration ? (await render(demonstration)).Content : null;

// Older pins carry no capability copy; the grid and the roadmap are omitted rather than invented.
const title = p.hero?.title ?? p.headline;
const subtitle = p.hero?.subtitle ?? p.description;
const proof = p.hero?.proof;
const capabilities = p.capabilities ?? [];
const planned = p.on_the_way ?? [];

const plannedHref = (item: { issue?: number; catalog?: string; doc?: string }): string | null => {
  if (typeof item.issue === 'number') return `${REPO_URL}/issues/${item.issue}`;
  if (item.catalog) return '/compatibility/';
  return docLink(item.doc, routes, bySource);
};

const install = [
  'git clone --branch stable \\',
  '  https://github.com/JakeSelby/model-citizen.git ~/repos/agent-harness',
  'cd ~/repos/agent-harness',
  'bin/citizen install',
  '# Homebrew packages, VS Code + extensions, Claude Code, Codex, gh, then sync',
].join('\n');

const headings = [
  ...(capabilities.length ? [{ depth: 2, slug: 'what-it-does', text: 'What it does for you' }] : []),
  { depth: 2, slug: 'how-it-loads', text: 'How it loads' },
  { depth: 2, slug: 'what-you-get', text: 'What you get' },
  { depth: 2, slug: 'the-ritual', text: 'The ritual' },
  ...(DemoContent ? [{ depth: 2, slug: 'stance-demo', text: 'A stance switch, in practice' }] : []),
  { depth: 2, slug: 'the-cli', text: 'The CLI' },
  { depth: 2, slug: 'honest', text: 'It keeps itself honest' },
  ...(planned.length ? [{ depth: 2, slug: 'on-the-way', text: 'On the way' }] : []),
];
---

<DocsLayout
  title="Overview"
  description={p.description}
  crumbs={[{ label: 'overview', mono: true }]}
  sourcePath="README.md"
  sourceLabel="View README on GitHub"
  headings={headings}
  kind="Overview"
  wide
>
  <section class="block hero">
    <div class="eyebrow">
      <span class="pill">Open source</span><span class="pill">MIT</span><span class="pill">Python 3.9+</span><a class="pill" href="/compatibility/">Compatibility catalog</a>
    </div>
    <h1>{title}</h1>
    <p class="lede">{subtitle}</p>
    <div class="cta">
      <a class="btn primary" href="/install/">Get started</a>
      <a class="btn" href={REPO_URL}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
        View on GitHub
      </a>
    </div>
    <div class="install">
      <SourceBlock code={install} lang="sh" label="Inspect and install" />
    </div>
    {proof && <p class="proof" set:html={inlineCode(proof)}></p>}
  </section>

  {capabilities.length > 0 && (
    <section class="block" id="what-it-does">
      <h2>What it does for you</h2>
      <div class="caps">
        {capabilities.map((group) => (
          <div class="cap">
            <h3>{group.title}</h3>
            <p class="pitch">{group.pitch}</p>
            <ul>
              {group.features.map((feature) => {
                const href = docLink(feature.doc, routes, bySource);
                return (
                  <li>
                    {href ? <a class="name" href={href}>{feature.name}</a> : <span class="name">{feature.name}</span>}
                    <span class="line">{feature.line}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="block">
    <div class="pillars">
      <div><span class="k">Your working style</span><h2>You choose the behavior</h2><p>Make preferences explicit and switch them as your work changes.</p></div>
      <div><span class="k">Personal stances</span><h2>Switch a policy, keep one source</h2><p>Compare the <a href="/stances/delegation/">delegation variants</a> and inspect their resolved behavior.</p></div>
      <div><span class="k">Custom primitives</span><h2>Extend what the harness can express</h2><p>Author your own stance dimensions, skills, roles and workflows.</p></div>
    </div>
  </section>

  <section class="block" id="how-it-loads">
    <h2>How it loads</h2>
    <p class="section-lede">One shared primitive authority, projected through runtime adapters. User defaults, explicit project choices and session overrides have documented precedence.</p>
    <LayerDiagram />
    <p class="ladder-note">Owned configuration is reconciled with your files; conflicts stay visible. Read the <a href="/docs/sync-model/">sync model</a> before adopting an existing setup.</p>
  </section>

  <section class="block" id="what-you-get">
    <h2>What you get</h2>
    <div class="counts">
      <a href="/rules/"><span class="n num">{c.rules}</span><span class="lbl">Rules</span></a>
      <a href="/stances/"><span class="n num">{c.stanceDimensions}<small>· {c.stanceVariants} variants</small></span><span class="lbl">Stances</span></a>
      <a href="/skills/"><span class="n num">{c.skills}</span><span class="lbl">Skills</span></a>
      <a href="/agents/"><span class="n num">{c.agents}</span><span class="lbl">Roles</span></a>
      <a href="/commands/"><span class="n num">{c.commands}</span><span class="lbl">Workflows</span></a>
      <a href="/hooks/"><span class="n num">{c.hooks}</span><span class="lbl">Policy checks</span></a>
      <a href="/output-styles/"><span class="n num">{c.outputStyles}</span><span class="lbl">Output style</span></a>
      <a href="/docs/"><span class="n num">{c.docs}</span><span class="lbl">Docs</span></a>
    </div>
  </section>

  <section class="block" id="the-ritual">
    <h2>The ritual, in {c.commands} keystrokes</h2>
    <div class="ritual">
      {r.commands.map((cmd, i) => (
        <>
          <a href={cmd.route}>{cmd.label}</a>
          {i < r.commands.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
        </>
      ))}
    </div>
    <p class="ritual-note">
      Read-only gatherers fan out for one digest; a Review Card stops at the build gate; the build lands in its own worktree and opens the pull request;
      two fresh contexts review scope then quality; the handoff file is what the next session reads.
    </p>
  </section>

  <section class="block folds">
  {DemoContent && (
    <>
      <h2 id="stance-demo">A stance switch, in practice</h2>
      <details class="fold">
        <summary>Show one stance switch, end to end</summary>
        <div class="harness-prose"><DemoContent /></div>
      </details>
    </>
  )}
    <h2 id="the-cli">The CLI</h2>
    <details class="fold">
      <summary>Show every subcommand</summary>
      <dl class="cli">
        {cli.map((cmd) => (
          <>
            <dt><a href={`/cli/#${cmd.name}`}>{cmd.name}</a></dt>
            <dd>{cmd.help}</dd>
          </>
        ))}
      </dl>
      <p class="ritual-note"><a href="/cli/">Read the full CLI reference</a>.</p>
    </details>
  </section>

  <section class="block" id="honest">
    <h2>It keeps itself honest</h2>
    <div class="honest">
      <div>
        <b>{h.cap} lines, always loaded, lint-enforced</b>
        <code>CLAUDE.md</code> plus the rules plus the longest variant of every stance may never exceed the cap. <code>harness lint</code> fails the commit if they do.
      </div>
      <div>
        <b class="num">{h.tests} test definitions in the release</b>
        The CLI, the hooks and the lint are covered by {h.testFiles} standard-library test files; CI runs lint then test definitions in the release and pull request.
      </div>
      <div>
        <b>One source, native projections</b>
        Shared primitives produce linked or generated runtime artifacts; <code>harness diff</code> shows anything that drifted.
      </div>
      <div>
        <b>Nothing personal in the tree</b>
        Identity, stances and permissions live in <code>~/.config/agent-harness/config.json</code>; lint checks source for personal-data shapes and secrets.
      </div>
    </div>
    <details class="fold">
      <summary>Known limits</summary>
      {support.limitations.map((note: string) => <p class="muted small">{note}</p>)}
      <p class="ritual-note">The <a href="/compatibility/">compatibility catalog</a> identifies qualified clients and capability gaps.</p>
    </details>
    <p class="ritual-note">This page is generated from the <code>v{v}</code> tag of the repository. Every count, description and CLI line above is read from the checkout at build time.</p>
  </section>

  {planned.length > 0 && (
    <section class="block" id="on-the-way">
      <h2>On the way</h2>
      <p class="section-lede">Planned, not promised.</p>
      <ul class="planned">
        {planned.map((item) => {
          const href = plannedHref(item);
          return (
            <li>
              {href ? <a class="name" href={href}>{item.title}</a> : <span class="name">{item.title}</span>}
              <span class="line">{item.line}</span>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</DocsLayout>
