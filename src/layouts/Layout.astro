---
import '../styles/global.css';
import SearchPalette from '../components/SearchPalette.astro';
import { version } from '../lib/harness/registry.ts';
import { REPO_URL } from '../lib/harness/paths.ts';

interface Props {
  title: string;
  description: string;
  hasSidebar?: boolean;
}
const { title, description, hasSidebar = false } = Astro.props;
const v = version();
const ogImage = new URL('/og.png', Astro.site ?? 'https://model-citizen.dev').href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://model-citizen.dev').href;
const fullTitle = Astro.url.pathname === '/' ? 'Model Citizen: the reference' : `${title} · Model Citizen`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Jake Selby" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Model Citizen" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Model Citizen. Your way of working, across AI agents. Projected into Claude Code and Codex." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
    <script is:inline src="/analytics.js" defer></script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <aside class="rename" aria-label="Name change">
      <p>Model Citizen was formerly <a href="https://github.com/JakeSelby/model-citizen">agent-harness</a>: same project, new name.</p>
    </aside>
    <header class="topbar">
      <div class="topbar-inner">
        {hasSidebar && (
          <button class="btn menu-btn" id="menuBtn" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        )}
        <span class="wordmark"><a href="/">Model Citizen</a> <span class="by">by <a href="https://jakeselby.com">Jake Selby</a></span></span>
        <a class="pill amber num" href="/changelog/" title="Changelog">v{v}</a>
        <div class="topbar-right">
          <button class="btn search-btn" id="searchBtn" aria-label="Search the reference">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <span>Search rules, skills, hooks…</span>
            <kbd class="key">⌘K</kbd>
          </button>
          <a class="btn" href={REPO_URL} aria-label="Model Citizen on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </header>
    <slot />
    <footer class="foot">
      <div class="foot-inner">
        <span>Model Citizen · MIT · v{v}</span>
        <a href="/contributing/">Contributing</a>
        <a href="/changelog/">Changelog</a>
        <a href="/manifest.json">manifest.json</a>
        <a href={REPO_URL}>GitHub</a>
        <a class="r" href="https://jakeselby.com">jakeselby.com</a>
      </div>
    </footer>
    <SearchPalette />
    <script>
      // Copy buttons: one for every dark code island, plus the ones the pages place by hand.
      document.querySelectorAll<HTMLPreElement>('pre.astro-code').forEach((pre) => {
        if (pre.querySelector('.code-copy') || pre.closest('.code')) return;
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'code-copy';
        b.textContent = 'Copy';
        b.setAttribute('aria-label', 'Copy code');
        pre.appendChild(b);
      });
      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.code-copy');
        if (!b) return;
        const host = b.closest('.code') ?? b.closest('pre');
        const pre = host?.querySelector('pre') ?? (host as HTMLElement | null);
        const text = pre?.textContent?.replace(/Copy$|Copied$/, '') ?? '';
        const done = () => {
          b.textContent = 'Copied';
          setTimeout(() => (b.textContent = 'Copy'), 1500);
        };
        if (navigator.clipboard) navigator.clipboard.writeText(text.trimEnd()).then(done, done);
        else done();
      });

      // The sidebar drawer on narrow screens.
      const menuBtn = document.getElementById('menuBtn');
      const sidebar = document.getElementById('sidebar');
      const scrim = document.getElementById('scrim');
      const setOpen = (open: boolean) => {
        sidebar?.classList.toggle('open', open);
        scrim?.classList.toggle('on', open);
        menuBtn?.setAttribute('aria-expanded', String(open));
      };
      menuBtn?.addEventListener('click', () => setOpen(!sidebar?.classList.contains('open')));
      scrim?.addEventListener('click', () => setOpen(false));
    </script>
  </body>
</html>
